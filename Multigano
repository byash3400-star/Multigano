<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Multigano by Yash Badgujar</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700;900&family=Great+Vibes&family=Poppins:wght@500;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0d0924;--card:#18133ad9;--tx:#f8f6ff;--mut:#c4bfe6;
  --ac:#9333ea;--ac2:#f43f5e;--gold:#fbbf24;--cell:#2b235a;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px)
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;min-height:100vh}
body{
  background:var(--bg);color:var(--tx);
  font-family:'Poppins',system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  display:flex;flex-direction:column;align-items:center;
  padding:14px 14px 36px;overflow-x:hidden;position:relative
}

/* Fullscreen 3D Animated Canvas Layer */
#bg-canvas{
  position:fixed;inset:0;width:100vw;height:100vh;
  z-index:0;pointer-events:none
}

/* Bold Broad Calligraphy Header */
.hero-header{
  position:relative;z-index:3;text-align:center;margin:6px 0 8px;
  transition:transform .6s cubic-bezier(.2,1.3,.4,1), opacity .5s
}
.cal-main{
  font-family:'Great Vibes',cursive;
  font-weight:900;
  font-size:clamp(3.6rem,13vw,6.2rem);
  line-height:.95;margin:0;
  background:linear-gradient(180deg,#fff7ed 0%,#fde047 38%,#f43f5e 78%,#a855f7 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  -webkit-text-stroke:1.2px rgba(255,255,255,0.35);
  filter:drop-shadow(0 5px 0 #2e1065) drop-shadow(0 12px 24px rgba(0,0,0,0.75));
  letter-spacing:2px;
  transform:skewX(-4deg);
}
.cal-author{
  display:block;
  font-family:'Cinzel Decorative','Great Vibes',serif;
  font-weight:900;
  font-size:clamp(1.05rem,3.6vw,1.65rem);
  letter-spacing:3.5px;
  text-transform:uppercase;
  margin-top:4px;
  background:linear-gradient(90deg,#fde047,#ffffff,#f9a8d4);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  filter:drop-shadow(0 3px 6px rgba(0,0,0,0.85));
}
.hero-header.mini .cal-main{font-size:clamp(2.3rem,7vw,3.1rem)}
.hero-header.mini .cal-author{font-size:clamp(.75rem,2.4vw,1rem);letter-spacing:2px;margin-top:0}

.sub{
  position:relative;z-index:3;color:#f3e8ff;
  font-weight:600;font-size:.9rem;margin:2px 0 12px;
  text-shadow:0 2px 10px rgba(0,0,0,.85);text-align:center
}

.top-controls{
  position:relative;z-index:3;display:flex;flex-wrap:wrap;gap:8px;
  justify-content:center;margin-bottom:14px
}

/* Intro Reveal Transition */
#main-stage{
  position:relative;z-index:3;width:100%;display:flex;flex-direction:column;align-items:center;
  transition:opacity .85s ease, transform .85s cubic-bezier(.2,1.25,.4,1);
}
body.intro-playing #main-stage{
  opacity:0;transform:translateY(42px) scale(.96);pointer-events:none
}
body.intro-playing .hero-header{
  transform:translateY(12vh) scale(1.06);
}
#skip-intro{
  position:fixed;bottom:22px;right:20px;z-index:10;
  background:rgba(15,10,40,.78);border:1.5px solid #fde04788;color:#fde047;
  padding:8px 16px;border-radius:99px;font:inherit;font-size:.82rem;font-weight:700;
  cursor:pointer;backdrop-filter:blur(8px);box-shadow:0 6px 20px #0008;
  transition:.2s
}
#skip-intro:hover{background:#fde047;color:#120c2e}
body:not(.intro-playing) #skip-intro{display:none}

/* 20-Game Grid */
.menu{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
  gap:13px;width:100%;max-width:780px;margin-bottom:24px
}
.gc{
  background:linear-gradient(155deg,rgba(255,255,255,.16),rgba(255,255,255,.04)),var(--card);
  border:1.5px solid rgba(255,255,255,.26);backdrop-filter:blur(12px);
  border-radius:20px;padding:18px 12px;text-align:center;cursor:pointer;
  color:var(--tx);font:inherit;box-shadow:0 8px 24px rgba(0,0,0,.45);
  transition:transform .22s,border-color .22s,box-shadow .22s;
  position:relative;overflow:hidden;
  animation:cardPop .55s cubic-bezier(.2,1.3,.4,1) both;
  animation-delay:calc(var(--i)*35ms)
}
@keyframes cardPop{from{opacity:0;transform:translateY(22px) scale(.9)}}
.gc:hover{transform:translateY(-5px) scale(1.02);border-color:#fde047;box-shadow:0 12px 28px rgba(147,51,234,.45)}
.gc:active{transform:scale(.95)}
.gc span.i{font-size:2.35rem;display:block;filter:drop-shadow(0 4px 8px #0006)}
.gc b{display:block;font-size:1.02rem;margin-top:6px;letter-spacing:.2px}
.gc small{color:var(--mut);font-size:.76rem;display:block;margin-top:2px}
.gc .bg-tag{
  display:inline-block;margin-top:6px;font-size:.65rem;font-weight:700;
  padding:2px 8px;border-radius:99px;background:rgba(255,255,255,.1);color:#fde047
}

/* Active Game Panel */
.game{
  display:none;width:100%;max-width:450px;flex-direction:column;align-items:center;gap:10px;
  background:var(--card);backdrop-filter:blur(14px);
  border:1.5px solid rgba(255,255,255,.28);padding:16px;border-radius:22px;
  box-shadow:0 12px 40px rgba(0,0,0,.65)
}
.bar{display:flex;justify-content:space-between;align-items:center;width:100%;gap:8px}
button.b{
  background:linear-gradient(90deg,var(--ac),var(--ac2));color:#fff;border:0;
  border-radius:12px;padding:9px 15px;font:inherit;font-weight:700;cursor:pointer;
  box-shadow:0 4px 0 #581c87,0 8px 18px rgba(147,51,234,.45);transition:.12s
}
button.b:hover{filter:brightness(1.12);transform:translateY(-2px)}
button.b:active{transform:translateY(3px) scale(.95)}
.sc{background:rgba(0,0,0,.38);border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:6px 12px;font-weight:700;text-align:center;font-size:.86rem}
canvas.gcv{width:100%;max-width:390px;border-radius:16px;touch-action:none;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.15)}
.msg{min-height:1.4em;font-weight:700;color:#fde047;text-align:center;font-size:.95rem}
.hint{color:var(--mut);font-size:.8rem;text-align:center;margin:0}
input[type=range]{width:100%;accent-color:var(--ac2)}

.pills{display:flex;flex-wrap:wrap;gap:6px;justify-content:center}.pills s{flex-basis:100%;height:0}
.pl{
  border:1.5px solid rgba(255,255,255,.3);background:rgba(15,10,40,.55);color:var(--tx);
  border-radius:99px;padding:5px 12px;font:inherit;font-size:.78rem;font-weight:700;
  cursor:pointer;backdrop-filter:blur(6px);transition:.15s
}
.pl.on{background:linear-gradient(90deg,var(--ac),var(--ac2));border-color:#fde047;color:#fff;box-shadow:0 0 14px rgba(236,72,153,.6);transform:scale(1.05)}

/* Game Specific Layouts */
#board{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;background:rgba(0,0,0,.35);padding:8px;border-radius:16px;width:100%;aspect-ratio:1;touch-action:none}
.t{border-radius:10px;background:var(--cell);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:clamp(1.2rem,6vw,2rem);color:#fff}
.ttt{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;width:min(100%,290px)}
.tc{aspect-ratio:1;border:0;border-radius:16px;background:var(--cell);font-size:2.8rem;font-weight:800;cursor:pointer;color:#c084fc;box-shadow:0 4px 12px #0004}
.tc.O{color:#fb7185}
.fgr{display:grid;gap:7px;width:100%}.fc{aspect-ratio:1;perspective:600px;cursor:pointer}
.fc .in{position:relative;width:100%;height:100%;transition:transform .45s;transform-style:preserve-3d}.fc.on .in{transform:rotateY(180deg)}
.fc b,.fc u{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;border-radius:12px;backface-visibility:hidden;font-size:clamp(1.2rem,6vw,2rem);text-decoration:none}
.fc b{background:linear-gradient(135deg,var(--ac),var(--ac2));color:#fff}.fc u{background:var(--cell);transform:rotateY(180deg)}
.lb{display:grid;grid-template-columns:repeat(10,1fr);width:100%;border-radius:12px;overflow:hidden;box-shadow:0 6px 20px #0004}
.lc{aspect-ratio:1;font-size:.55rem;position:relative;background:var(--cell);border:1px solid #8882;padding:1px;color:var(--mut)}
.lc em{display:block;font-style:normal;color:var(--tx);font-weight:700}
.tk{position:absolute;right:2px;bottom:2px;width:38%;aspect-ratio:1;border-radius:50%;border:2px solid #fff;background:#7c3aed}.tk.t1{background:#ec4899;right:auto;left:2px}
.row{display:flex;gap:12px;align-items:center;justify-content:center;flex-wrap:wrap}
.dice{width:54px;height:54px;border-radius:14px;background:#fff;color:#111;display:flex;align-items:center;justify-content:center;font-size:1.7rem;font-weight:800;box-shadow:0 4px 12px #0004}
.dice.spin{animation:spin .6s}@keyframes spin{to{transform:rotate(720deg) scale(1.2)}}
.wg{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;width:min(100%,320px)}
.wh{aspect-ratio:1;border-radius:50%;background:radial-gradient(#2b1a3a 55%,#4a2b6b);overflow:hidden;position:relative;cursor:pointer;box-shadow:inset 0 -8px 12px #0008}
.wh span{position:absolute;left:0;right:0;text-align:center;font-size:3rem;top:100%;transition:top .12s}.wh.up span{top:18%}
.cb{display:grid;grid-template-columns:repeat(8,1fr);width:min(100%,350px);aspect-ratio:1;border-radius:10px;overflow:hidden;box-shadow:0 6px 20px #0005}
.sq{display:flex;align-items:center;justify-content:center;font-size:clamp(1.5rem,7.5vw,2.2rem);cursor:pointer;position:relative;line-height:1}
.sq.l{background:#312e81}.sq.d{background:#1e1b4b}.sq.sl{background:#f6d55c!important}
.sq.hl::after{content:"";width:28%;height:28%;border-radius:50%;background:#fff7;position:absolute}
.pw{color:#fff;text-shadow:0 0 3px #000}.pk{color:#fb7185}
.c4{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;background:#1d4ed8;padding:6px;border-radius:14px;width:min(100%,360px)}
.c4c{aspect-ratio:1;border-radius:50%;background:#0f172a;cursor:pointer}.c4c.p1{background:#ef4444}.c4c.p2{background:#facc15}

/* Minesweeper */
.ms-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:4px;width:min(100%,350px)}
.ms-cell{aspect-ratio:1;border:0;border-radius:8px;background:#312e81;color:#fff;font-weight:800;font-size:1rem;cursor:pointer;display:flex;align-items:center;justify-content:center}
.ms-cell.rev{background:#0f172a;cursor:default}.ms-cell.mine{background:#e11d48}

/* Simon Says */
.simon-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;width:min(100%,280px)}
.sm-btn{aspect-ratio:1;border:0;border-radius:24px;cursor:pointer;opacity:.65;transition:.15s;box-shadow:0 8px 20px #0006}
.sm-btn.lit{opacity:1;transform:scale(1.06);box-shadow:0 0 28px #fff}

/* Mini Sudoku (4x4 & 6x6) */
.sdk-grid{display:grid;gap:4px;width:min(100%,320px);background:#0f172a;padding:6px;border-radius:14px}
.sdk-cell{aspect-ratio:1;border:1px solid #ffffff22;border-radius:8px;background:#1e1b4b;color:#fff;font-size:1.3rem;font-weight:800;display:flex;align-items:center;justify-content:center;cursor:pointer}
.sdk-cell.fix{background:#312e81;color:#fde047;cursor:default}.sdk-cell.sel{outline:2.5px solid #ec4899}
</style>
</head>
<body class="intro-playing">

<canvas id="bg-canvas"></canvas>
<button id="skip-intro" onclick="finishIntro()">Skip Intro ⏭</button>

<header class="hero-header" id="hero">
  <h1 class="cal-main">Multigano</h1>
  <span class="cal-author">by Yash Badgujar</span>
</header>

<div id="main-stage">
  <p class="sub">20 Offline Games · 3D Mountain Bird Intro · Unique Live 3D Backdrop per Game</p>
  <div class="top-controls">
    <button class="pl on" id="bg-toggle" onclick="toggleBG()">🎬 3D Live BG: ON</button>
    <button class="pl" onclick="replayIntro()">🦅 Replay 3D Bird Intro</button>
  </div>
  <div class="menu" id="menu"></div>
</div>

<!-- 1. Number Merge -->
<div class="game" id="g1">
 <div class="bar"><button class="b" onclick="go()">← Menu</button><div class="sc">Score <span id="s1">0</span></div><div class="sc">Best <span id="b1">0</span></div></div>
 <div id="board"></div><div class="msg" id="m1"></div>
 <p class="hint">Swipe or arrow keys. Merge matching numbers!</p>
 <button class="b" onclick="mInit()">New game</button>
</div>

<!-- 2. Carrom Pool -->
<div class="game" id="g2">
 <div class="bar"><button class="b" onclick="go()">← Menu</button><div class="sc">Score <span id="s2">0</span></div><div class="sc">Shots <span id="sh">0</span></div></div>
 <canvas class="gcv" id="cv" width="400" height="400"></canvas>
 <input type="range" id="sx" min="80" max="320" value="200" aria-label="Striker position">
 <div class="msg" id="m2"></div>
 <p class="hint">Slide striker, pull back & release. White +10, Black +20, Queen +50.</p>
 <button class="b" onclick="cInit()">New game</button>
</div>

<!-- 3. Snake -->
<div class="game" id="g3">
 <div class="bar"><button class="b" onclick="go()">← Menu</button><div class="sc">Score <span id="s3">0</span></div><div class="sc">Best <span id="b3">0</span></div></div>
 <canvas class="gcv" id="sk" width="360" height="360"></canvas><div class="msg" id="m3"></div>
 <p class="hint">Arrow keys or swipe on board.</p>
 <button class="b" onclick="sInit()">New game</button>
</div>

<script>
/* =========================================================================
   3D MOUNTAIN + SOARING BIRD LANDING INTRO + 20 UNIQUE LIVE GAME BACKGROUNDS
   ========================================================================= */
const bgCanvas = document.getElementById('bg-canvas');
const bgCtx = bgCanvas.getContext('2d');
let bgOn = true, bgTime = 0, activeScene = 'menu';
let introProgress = 0; // 0 -> 1 over ~4.2 seconds
let introDone = false;

function resizeBG(){
  bgCanvas.width = window.innerWidth;
  bgCanvas.height = window.innerHeight;
}
window.addEventListener('resize', resizeBG);
resizeBG();

function finishIntro(){
  introProgress = 1;
  introDone = true;
  document.body.classList.remove('intro-playing');
}
function replayIntro(){
  if(cur) go();
  introProgress = 0;
  introDone = false;
  document.body.classList.add('intro-playing');
}
function toggleBG(){
  bgOn = !bgOn;
  const b = document.getElementById('bg-toggle');
  b.textContent = bgOn ? '🎬 3D Live BG: ON' : '🎬 3D Live BG: OFF';
  b.classList.toggle('on', bgOn);
}

// Persistent particles for varied 3D scenes
const stars3D = Array.from({length: 90}, () => ({
  x: (Math.random() - 0.5) * 2,
  y: (Math.random() - 0.5) * 2,
  z: Math.random()
}));
const motes = Array.from({length: 55}, () => ({
  x: Math.random(), y: Math.random(),
  r: Math.random() * 3.5 + 1,
  sp: Math.random() * 0.4 + 0.15,
  ph: Math.random() * Math.PI * 2
}));

/* Draw 3D Sunrise Mountain Range, Valley Lake, Foreground Land & 3D Soaring Bird */
function drawMountainBirdScene(t, prog){
  const W = bgCanvas.width, H = bgCanvas.height;
  // Ease function for smooth flight & landing
  const ease = p => 1 - Math.pow(1 - Math.min(1, p), 3);
  const e = ease(prog);

  // 1. Vibrant Sunrise / Golden-Violet Sky Gradient
  const sky = bgCtx.createLinearGradient(0, 0, 0, H * 0.78);
  sky.addColorStop(0, '#0f0829');
  sky.addColorStop(0.32, '#3b155f');
  sky.addColorStop(0.62, '#be185d');
  sky.addColorStop(0.84, '#f97316');
  sky.addColorStop(1, '#fde047');
  bgCtx.fillStyle = sky;
  bgCtx.fillRect(0, 0, W, H);

  // 2. Radiant 3D Sun rising behind peaks
  const sunX = W * 0.5 + Math.sin(t * 0.15) * 24;
  const sunY = H * (0.58 - e * 0.11);
  const sunR = Math.min(W, H) * 0.14;
  const halo = bgCtx.createRadialGradient(sunX, sunY, sunR * 0.1, sunX, sunY, sunR * 3.2);
  halo.addColorStop(0, 'rgba(254, 240, 138, 0.95)');
  halo.addColorStop(0.35, 'rgba(251, 146, 60, 0.45)');
  halo.addColorStop(1, 'rgba(244, 63, 94, 0)');
  bgCtx.fillStyle = halo;
  bgCtx.fillRect(0, 0, W, H);

  bgCtx.beginPath();
  bgCtx.arc(sunX, sunY, sunR, 0, Math.PI * 2);
  bgCtx.fillStyle = '#fef9c3';
  bgCtx.fill();

  // 3. Far 3D Mountain Peaks (with lit & shaded facets for 3D depth)
  const drawPeakLayer = (peaks, baseY, litCol, shadeCol, snowCol, parallax) => {
    const shift = Math.sin(t * 0.25) * parallax;
    for(let i = 0; i < peaks.length - 1; i++){
      const x1 = peaks[i][0] * W + shift, y1 = peaks[i][1] * H;
      const x2 = peaks[i+1][0] * W + shift, y2 = peaks[i+1][1] * H;
      const midX = (x1 + x2) * 0.52;
      const peakY = Math.min(y1, y2) - (peaks[i][2] || 0) * H;
      // Left sunlit face
      bgCtx.beginPath();
      bgCtx.moveTo(x1, baseY);
      bgCtx.lineTo(midX, peakY);
      bgCtx.lineTo(midX + (x2 - midX)*0.25, baseY);
      bgCtx.closePath();
      bgCtx.fillStyle = litCol;
      bgCtx.fill();
      // Right shadow face
      bgCtx.beginPath();
      bgCtx.moveTo(midX, peakY);
      bgCtx.lineTo(x2, baseY);
      bgCtx.lineTo(midX + (x2 - midX)*0.25, baseY);
      bgCtx.closePath();
      bgCtx.fillStyle = shadeCol;
      bgCtx.fill();
      // Snow cap
      if(snowCol){
        bgCtx.beginPath();
        bgCtx.moveTo(midX, peakY);
        bgCtx.lineTo(midX - (midX - x1)*0.26, peakY + (baseY - peakY)*0.24);
        bgCtx.lineTo(midX + (x2 - midX)*0.24, peakY + (baseY - peakY)*0.22);
        bgCtx.closePath();
        bgCtx.fillStyle = snowCol;
        bgCtx.fill();
      }
    }
  };

  drawPeakLayer(
    [[-0.1,0.58,0.22],[0.18,0.55,0.28],[0.45,0.54,0.32],[0.72,0.56,0.26],[1.1,0.58,0.2]],
    H * 0.68, '#6d28d9', '#3b0764', '#fde68a88', 8
  );

  // Drifting volumetric mountain mist
  const mist = bgCtx.createLinearGradient(0, H*0.52, 0, H*0.72);
  mist.addColorStop(0, 'rgba(253,186,116,0)');
  mist.addColorStop(0.5, 'rgba(253,186,116,0.28)');
  mist.addColorStop(1, 'rgba(49,16,82,0)');
  bgCtx.fillStyle = mist;
  bgCtx.fillRect(0, H*0.52, W, H*0.2);

  // Mid 3D Mountains
  drawPeakLayer(
    [[-0.15,0.66,0.24],[0.22,0.64,0.3],[0.55,0.65,0.27],[0.88,0.63,0.31],[1.15,0.66,0.2]],
    H * 0.74, '#4c1d95', '#1e1b4b', '#fbcfe866', 16
  );

  // 4. Shimmering Valley Water / Lake
  const lakeY = H * 0.68;
  const lake = bgCtx.createLinearGradient(0, lakeY, 0, H * 0.84);
  lake.addColorStop(0, '#312e81');
  lake.addColorStop(0.5, '#1e1b4b');
  lake.addColorStop(1, '#0f172a');
  bgCtx.fillStyle = lake;
  bgCtx.fillRect(0, lakeY, W, H * 0.16);

  // Sun reflection ripples on water
  bgCtx.fillStyle = 'rgba(253, 224, 71, 0.25)';
  for(let r = 0; r < 10; r++){
    const ry = lakeY + r * (H * 0.014) + 4;
    const rw = (28 + r * 14) + Math.sin(t * 3 + r) * 12;
    bgCtx.fillRect(sunX - rw/2 + Math.sin(t*2+r)*6, ry, rw, 2.5);
  }

  // 5. 3D Foreground Land / Grassy Cliff & Landing Rock
  const landY = H * 0.78;
  const landGrad = bgCtx.createLinearGradient(0, landY, 0, H);
  landGrad.addColorStop(0, '#15803d');
  landGrad.addColorStop(0.35, '#14532d');
  landGrad.addColorStop(1, '#052e16');
  bgCtx.fillStyle = landGrad;
  bgCtx.beginPath();
  bgCtx.moveTo(0, landY + 18);
  bgCtx.quadraticCurveTo(W * 0.35, landY - 14, W * 0.68, landY + 10);
  bgCtx.quadraticCurveTo(W * 0.86, landY + 22, W, landY + 4);
  bgCtx.lineTo(W, H);
  bgCtx.lineTo(0, H);
  bgCtx.closePath();
  bgCtx.fill();

  // 3D Landing Rock / Perch on the right-center foreground
  const perchX = W * 0.74;
  const perchY = landY + 12;
  bgCtx.fillStyle = '#334155';
  bgCtx.beginPath();
  bgCtx.ellipse(perchX, perchY + 10, 56, 18, 0, 0, Math.PI * 2);
  bgCtx.fill();
  bgCtx.fillStyle = '#64748b';
  bgCtx.beginPath();
  bgCtx.ellipse(perchX - 4, perchY + 6, 48, 13, 0, 0, Math.PI * 2);
  bgCtx.fill();

  // 6. 3D SOARING BIRD COMING FROM THE MOUNTAINS & LANDING ON THE LAND
  // Path: starts tiny deep in the mountain pass (0.45, 0.48), swoops in a 3D arc towards foreground perch
  const flightT = Math.min(1, prog);
  const arcX = (1 - flightT) * (W * 0.44) + flightT * perchX - Math.sin(flightT * Math.PI) * (W * 0.16);
  const arcY = (1 - flightT) * (H * 0.47) + flightT * (perchY - 14) - Math.sin(flightT * Math.PI) * (H * 0.14);
  // 3D depth scale grows from 0.14 (distant mountain) to 1.05 (foreground land)
  const birdScale = 0.14 + Math.pow(flightT, 1.35) * 0.92;
  const landed = flightT >= 0.98;

  // Ground shadow on land when bird approaches landing
  if(flightT > 0.55){
    const shAlpha = (flightT - 0.55) / 0.45 * 0.45;
    bgCtx.fillStyle = `rgba(0,0,0,${shAlpha})`;
    bgCtx.beginPath();
    bgCtx.ellipse(arcX, perchY + 4, 24 * birdScale, 7 * birdScale, 0, 0, Math.PI * 2);
    bgCtx.fill();
  }

  // Draw 3D Articulated Golden-Phoenix / Eagle Bird
  bgCtx.save();
  bgCtx.translate(arcX, arcY + (landed ? Math.sin(t * 3) * 1.5 : 0));
  bgCtx.scale(birdScale, birdScale);
  const bankAngle = landed ? 0 : Math.cos(flightT * Math.PI) * 0.25;
  bgCtx.rotate(bankAngle);

  // Wing flap animation (fast in air, folded nicely when landed)
  const flap = landed ? 0.15 : Math.sin(t * 14) * 0.85;

  // Tail feathers
  bgCtx.fillStyle = '#ea580c';
  bgCtx.beginPath();
  bgCtx.moveTo(-10, 4);
  bgCtx.lineTo(-34, 14);
  bgCtx.lineTo(-28, 2);
  bgCtx.lineTo(-36, -4);
  bgCtx.closePath();
  bgCtx.fill();

  // Far Wing (3D depth shaded)
  bgCtx.fillStyle = '#b45309';
  bgCtx.beginPath();
  bgCtx.moveTo(0, -4);
  bgCtx.quadraticCurveTo(-12, -38 * flap - 12, -36, -26 * flap - 8);
  bgCtx.quadraticCurveTo(-14, -8, 6, 0);
  bgCtx.fill();

  // 3D Torso & Chest
  const bodyGrad = bgCtx.createLinearGradient(-15, -10, 18, 12);
  bodyGrad.addColorStop(0, '#f59e0b');
  bodyGrad.addColorStop(0.5, '#fde047');
  bodyGrad.addColorStop(1, '#dc2626');
  bgCtx.fillStyle = bodyGrad;
  bgCtx.beginPath();
  bgCtx.ellipse(0, 0, 20, 10, -0.15, 0, Math.PI * 2);
  bgCtx.fill();

  // Near Wing (bright golden-crimson 3D gradient)
  const wingGrad = bgCtx.createLinearGradient(0, -30, 0, 20);
  wingGrad.addColorStop(0, '#fef08a');
  wingGrad.addColorStop(0.6, '#f97316');
  wingGrad.addColorStop(1, '#be123c');
  bgCtx.fillStyle = wingGrad;
  bgCtx.beginPath();
  bgCtx.moveTo(4, -2);
  bgCtx.quadraticCurveTo(-8, -46 * flap - 8, -42, -32 * flap - 2);
  bgCtx.quadraticCurveTo(-18, 4, 8, 4);
  bgCtx.closePath();
  bgCtx.fill();

  // Head & Crest
  bgCtx.fillStyle = '#fef9c3';
  bgCtx.beginPath();
  bgCtx.arc(18, -7, 8, 0, Math.PI * 2);
  bgCtx.fill();

  // Beak
  bgCtx.fillStyle = '#f59e0b';
  bgCtx.beginPath();
  bgCtx.moveTo(25, -9);
  bgCtx.lineTo(35, -5);
  bgCtx.lineTo(25, -3);
  bgCtx.closePath();
  bgCtx.fill();

  // Eye
  bgCtx.fillStyle = '#0f172a';
  bgCtx.beginPath();
  bgCtx.arc(20, -8, 1.8, 0, Math.PI * 2);
  bgCtx.fill();

  bgCtx.restore();
}

/* 20 Distinct Animated 3D Backgrounds for Every Game */
function drawGameScene(id, t){
  const W = bgCanvas.width, H = bgCanvas.height;
  bgCtx.clearRect(0, 0, W, H);

  // Helper: 3D Starfield / Tunnel
  const drawTunnel = (c1, c2, shape) => {
    const g = bgCtx.createRadialGradient(W/2, H/2, 10, W/2, H/2, Math.max(W,H)*0.8);
    g.addColorStop(0, c1); g.addColorStop(1, c2);
    bgCtx.fillStyle = g; bgCtx.fillRect(0, 0, W, H);
    stars3D.forEach(s => {
      s.z -= 0.008; if(s.z <= 0.02) s.z = 1;
      const sx = W/2 + (s.x / s.z) * W * 0.45;
      const sy = H/2 + (s.y / s.z) * H * 0.45;
      const sz = (1 - s.z) * 5;
      bgCtx.fillStyle = `rgba(255,255,255,${1 - s.z})`;
      if(shape === 'sq') bgCtx.fillRect(sx - sz, sy - sz, sz*2, sz*2);
      else { bgCtx.beginPath(); bgCtx.arc(sx, sy, sz, 0, Math.PI*2); bgCtx.fill(); }
    });
  };

  // Helper: 3D Perspective Floor Grid
  const drawGrid3D = (skyA, skyB, lineCol, sunCol) => {
    const g = bgCtx.createLinearGradient(0, 0, 0, H);
    g.addColorStop(0, skyA); g.addColorStop(0.55, skyB); g.addColorStop(1, '#050312');
    bgCtx.fillStyle = g; bgCtx.fillRect(0, 0, W, H);
    if(sunCol){
      bgCtx.fillStyle = sunCol;
      bgCtx.beginPath(); bgCtx.arc(W/2, H*0.46, Math.min(W,H)*0.16, 0, Math.PI*2); bgCtx.fill();
    }
    const hz = H * 0.52;
    bgCtx.strokeStyle = lineCol; bgCtx.lineWidth = 1.5;
    for(let i = -12; i <= 12; i++){
      bgCtx.beginPath(); bgCtx.moveTo(W/2 + i*18, hz); bgCtx.lineTo(W/2 + i*140, H); bgCtx.stroke();
    }
    for(let r = 0; r < 10; r++){
      const p = ((r + (t * 2) % 1) / 10);
      const y = hz + Math.pow(p, 2) * (H - hz);
      bgCtx.beginPath(); bgCtx.moveTo(0, y); bgCtx.lineTo(W, y); bgCtx.stroke();
    }
  };

  // Helper: Floating 3D Orbs / Aurora
  const drawAurora = (c1, c2, c3, emoji) => {
    const g = bgCtx.createLinearGradient(0, 0, W, H);
    g.addColorStop(0, c1); g.addColorStop(0.5, c2); g.addColorStop(1, c3);
    bgCtx.fillStyle = g; bgCtx.fillRect(0, 0, W, H);
    motes.forEach((m, idx) => {
      const x = ((m.x + Math.sin(t * m.sp + m.ph) * 0.08 + 1) % 1) * W;
      const y = ((m.y - t * m.sp * 0.12 + 10) % 1) * H;
      bgCtx.fillStyle = `rgba(255,255,255,${0.15 + (idx%4)*0.07})`;
      bgCtx.beginPath(); bgCtx.arc(x, y, m.r * 2.2, 0, Math.PI*2); bgCtx.fill();
      if(emoji && idx % 6 === 0){
        bgCtx.font = `${18 + (idx%3)*8}px serif`;
        bgCtx.fillText(emoji, x, y);
      }
    });
  };

  switch(id){
    case 'g1': drawAurora('#1e1b4b', '#4c1d95', '#831843', '🔢'); break; // Number Merge: Neon Math Matrix
    case 'g2': drawAurora('#291505', '#451a03', '#78350f', '🎯'); break; // Carrom: Royal Warm Wood & Dust Motes
    case 'g3': drawGrid3D('#022c22', '#064e3b', '#34d39955', '#10b98133'); break; // Snake: Emerald Cyber Grid
    case 'g4': drawAurora('#172554', '#1e3a8a', '#4c1d95', '❌'); break; // Tic-Tac-Toe: Hologram Indigo
    case 'g5': drawAurora('#3b0764', '#701a75', '#881337', '✨'); break; // Memory: Enchanted Nebula
    case 'g6': drawAurora('#064e3b', '#14532d', '#713f12', '🎲'); break; // Snake & Ladder: Jungle Canopy Rays
    case 'g7': drawAurora('#422006', '#713f12', '#1e293b', '🔨'); break; // Whack-a-Mole: Sunset Meadow
    case 'g8': drawGrid3D('#0c4a6e', '#0284c7', '#fde04766', '#fef08a55'); break; // Lane Runner: Sky Highway
    case 'g9': drawGrid3D('#1e1b4b', '#be185d', '#f43f5e88', '#fb718566'); break; // Nitro Racer: Synthwave Sunset
    case 'gA': drawGrid3D('#090d16', '#1e293b', '#fbbf2444', '#fde04722'); break; // Chess: Grand Obsidian Marble
    case 'gB': drawAurora('#1e1b4b', '#312e81', '#831843', '👑'); break; // Ludo: Royal Carnival Lights
    case 'gC': drawTunnel('#1d4ed8', '#090d16', 'circle'); break; // Connect Four: Deep Ocean Bubbles
    case 'gD': drawTunnel('#3b0764', '#05020d', 'sq'); break; // Pong: Retro Warp Tunnel
    case 'gE': drawAurora('#0369a1', '#38bdf8', '#bae6fd', '☁️'); break; // Flappy Bird: High Altitude Clouds
    case 'gF': drawGrid3D('#0f172a', '#311042', '#a855f766', '#ec489944'); break; // Breakout: Laser Prism
    case 'gG': drawTunnel('#064e3b', '#020617', 'sq'); break; // Minesweeper: Sonar Radar Grid
    case 'gH': drawAurora('#4c0519', '#881337', '#1e1b4b', '🎵'); break; // Simon Says: Beat Pulse Waves
    case 'gI': drawTunnel('#020617', '#000000', 'circle'); break; // Space Invaders: Deep Galaxy Warp
    case 'gJ': drawAurora('#1e293b', '#334155', '#0f172a', '💠'); break; // Mini Sudoku: Zen Crystal
    case 'gK': drawGrid3D('#311042', '#831843', '#fde04755', '#f9731655'); break; // Tower Stacker: Skyline Sunset
    default: drawMountainBirdScene(t, 1);
  }
}

