let msB=[],msOv=false,msFl=false;
function msInit(){
  msOv=false;msFl=false;$('mgG').textContent='Tap to reveal safe cells';
  const mines=[8,10,13,16][lv];
  msB=Array.from({length:64},()=>({m:0,r:0,f:0,c:0}));
  let p=0;while(p<mines){const i=Math.random()*64|0;if(!msB[i].m){msB[i].m=1;p++}}
  for(let i=0;i<64;i++){
    const r=i>>3,c=i&7;let cnt=0;
    for(let dr=-1;dr<=1;dr++)for(let dc=-1;dc<=1;dc++){
      const nr=r+dr,nc=c+dc;if(nr>=0&&nr<8&&nc>=0&&nc<8&&msB[nr*8+nc].m)cnt++;
    }
    msB[i].c=cnt;
  }
  $('igG').textContent='💣 '+mines;msDraw();
}
function msTogFlag(){msFl=!msFl;$('ms-flag-btn').textContent=msFl?'🚩 Flag Mode: ON':'🚩 Flag Mode: OFF'}
function msDraw(){
  $('msg').innerHTML=msB.map((x,i)=>`<button class="ms-cell${x.r?' rev':''}${x.r&&x.m?' mine':''}" onclick="msClick(${i})">${x.r?(x.m?'💣':(x.c||'')):(x.f?'🚩':'')}</button>`).join('');
}
function msRev(i){
  const x=msB[i];if(x.r||x.f)return;x.r=1;
  if(x.c===0&&!x.m){
    const r=i>>3,c=i&7;
    for(let dr=-1;dr<=1;dr++)for(let dc=-1;dc<=1;dc++){
      const nr=r+dr,nc=c+dc;if(nr>=0&&nr<8&&nc>=0&&nc<8)msRev(nr*8+nc);
    }
  }
}
function msClick(i){
  if(msOv)return;const x=msB[i];
  if(msFl){if(!x.r){x.f=!x.f;msDraw()}return}
  if(x.f||x.r)return;
  if(x.m){msB.forEach(c=>{if(c.m)c.r=1});msOv=true;msDraw();$('mgG').textContent='💥 Boom! Mine hit';return}
  msRev(i);msDraw();
  if(msB.every(c=>c.m||c.r)){msOv=true;$('mgG').textContent='🏆 Field Cleared! You Win!'}
}

