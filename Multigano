const SDK_BASE=[[1,2,3,4],[3,4,1,2],[2,1,4,3],[4,3,2,1]];
let sdB=[],sdFix=[],sdSel=-1;
function sdInit(){
  const perm=[1,2,3,4].sort(()=>Math.random()-.5);
  const grid=SDK_BASE.map(r=>r.map(v=>perm[v-1]));
  if(Math.random()<.5)[grid[0],grid[1]]=[grid[1],grid[0]];
  if(Math.random()<.5)[grid[2],grid[3]]=[grid[3],grid[2]];
