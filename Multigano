mk('gF','Breakout','<canvas class="gcv" id="bcv" width="360" height="480"></canvas><button class="b" onclick="bkInit()">Restart</button>');
mk('gG','Minesweeper','<div class="ms-grid" id="msg"></div><div class="row"><button class="pl" id="ms-flag-btn" onclick="msTogFlag()">🚩 Flag Mode: OFF</button><button class="b" onclick="msInit()">New game</button></div>');
mk('gH','Simon Says','<div class="simon-grid" id="smg"></div><button class="b" onclick="smInit()">Restart</button>');
mk('gI','Space Invaders','<canvas class="gcv" id="icv" width="360" height="480"></canvas><div class="row"><button class="b" onclick="ivFire()">🔥 Fire Laser</button><button class="b" onclick="ivInit()">Restart</button></div>');
mk('gJ','Mini Sudoku','<div class="sdk-grid" id="sdg"></div><div class="row"><button class="pl" onclick="sdNum(1)">1</button><button class="pl" onclick="sdNum(2)">2</button><button class="pl" onclick="sdNum(3)">3</button><button class="pl" onclick="sdNum(4)">4</button><button class="pl" onclick="sdNum(0)">⌫</button></div><button class="b" onclick="sdInit()">New puzzle</button>');
mk('gK','Tower Stacker','<canvas class="gcv" id="tcv" width="360" height="480"></canvas><button class="b" onclick="tkInit()">New tower</button>');

['g1','g2','g3'].forEach(i=>{
  const p=document.createElement('div');
  p.className='pills';p.id='p'+i;
  $(i).firstElementChild.after(p);
});

$('menu').innerHTML=GAMES.map((g,i)=>`<button class="gc" style="--i:${i}" onclick="go('${g[0]}')"><span class="i">${g[1]}</span><b>${g[2]}</b><small>${g[3]}</small><span class="bg-tag">${g[4]}</span></button>`).join('');

swipe($('rcv'),d=>{if(d==0&&rp>0)rp--;if(d==1&&rp<rN-1)rp++;if(d==2)rUp()});
const nb=$('nb');if(nb){nb.onpointerdown=()=>rm?rb=true:rUp();nb.onpointerup=nb.onpointerleave=()=>rb=false}
addEventListener('keydown',e=>{
  const k=e.key;
  if(cur==='g8'||cur==='g9'){
    if(k==='ArrowLeft'&&rp>0)rp--;
    if(k==='ArrowRight'&&rp<rN-1)rp++;
    if(k===' '||k==='ArrowUp'){e.preventDefault();rm?rb=true:rUp()}
  }
  if(cur==='gE'&&(k===' '||k==='ArrowUp')){e.preventDefault();fbFlap()}
  if((cur==='gD'||cur==='gF')&&(k==='ArrowLeft'||k==='ArrowRight')){
    e.preventDefault();const o=cur==='gD'?pq:bq;o.x=Math.max(30,Math.min(330,o.x+(k==='ArrowLeft'?-28:28)))
  }
  if(cur==='gI'){
    if(k==='ArrowLeft')iv.px=Math.max(24,iv.px-22);
    if(k==='ArrowRight')iv.px=Math.min(336,iv.px+22);
    if(k===' '||k==='ArrowUp'){e.preventDefault();ivFire()}
  }
  if(cur==='gK'&&(k===' '||k==='ArrowDown')){e.preventDefault();tkDrop()}
});
addEventListener('keyup',e=>{if(e.key===' '||e.key==='ArrowUp')rb=false});

$('ucv').addEventListener('pointerdown',e=>{
  if(uOv||!uM.length||!uHum.includes(uP))return;
  const r=e.target.getBoundingClientRect(),x=(e.clientX-r.left)*360/r.width,y=(e.clientY-r.top)*360/r.height;
  const t=uM.find(t=>{const[a,b]=uXY(uP,t);return Math.hypot(a-x,b-y)<20});
  if(t!==undefined)uMove(t);
});
const px=(e,o)=>{const r=e.target.getBoundingClientRect();o.x=(e.clientX-r.left)*360/r.width};
['pointerdown','pointermove'].forEach(v=>{
  $('pcv').addEventListener(v,e=>px(e,pq));
  $('bcv').addEventListener(v,e=>px(e,bq));
  $('icv').addEventListener(v,e=>{const r=e.target.getBoundingClientRect();iv.px=Math.max(24,Math.min(336,(e.clientX-r.left)*360/r.width));if(v==='pointerdown')ivFire()});
});
$('fcv').addEventListener('pointerdown',fbFlap);
$('tcv').addEventListener('pointerdown',tkDrop);

// Start in Menu with 3D Mountain Bird Intro active
$('main-stage').style.display='flex';
document.querySelectorAll('.game').forEach(x=>x.style.display='none');
</script>
</body>
</html>
