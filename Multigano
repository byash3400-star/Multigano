  sdFix=Array(16).fill(1);
  let k=0;while(k<blanks){const i=Math.random()*16|0;if(sdFix[i]){sdFix[i]=0;sdB[i]=0;k++}}
  sdSel=-1;$('mgJ').textContent='Fill 1–4 in every row, column & 2×2 box';sdDraw();
}
function sdDraw(){
  const g=$('sdg');g.style.gridTemplateColumns='repeat(4,1fr)';
